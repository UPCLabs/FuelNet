<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header morado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="?attr/colorPrimary"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="28dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:layout_marginBottom="12dp"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva Estación"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registra tu punto de venta de combustible"
                android:textSize="14sp"
                android:textColor="?attr/colorOnPrimary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card: Información general -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título sección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="22dp"
                            android:background="?attr/colorPrimary"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información general"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnBackground" />

                    </LinearLayout>

                    <!-- Nombre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre de la estación"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="?attr/colorPrimary"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreEstacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Dirección -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Dirección"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="?attr/colorPrimary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDireccionEstacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Combustibles -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título sección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="22dp"
                            android:background="?attr/colorPrimary"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipos de combustible"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnBackground" />

                    </LinearLayout>

                    <!-- CORRIENTE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginBottom="12dp">

                        <CheckBox
                            android:id="@+id/cbCorriente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Corriente"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnBackground"
                            android:textStyle="bold"
                            android:buttonTint="?attr/colorPrimary" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPrecioCorriente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Precio por galón (COP)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginTop="10dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPrecioCorriente"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvRefCorriente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:drawablePadding="6dp"
                            android:background="@drawable/bg_price_badge"
                            tools:text="Precio CREG: $16.291/gal" />

                    </LinearLayout>

                    <!-- EXTRA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginBottom="12dp">

                        <CheckBox
                            android:id="@+id/cbExtra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Extra"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnBackground"
                            android:textStyle="bold"
                            android:buttonTint="?attr/colorPrimary" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPrecioExtra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Precio por galón (COP)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginTop="10dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPrecioExtra"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- DIESEL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <CheckBox
                            android:id="@+id/cbDiesel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diesel"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnBackground"
                            android:textStyle="bold"
                            android:buttonTint="?attr/colorPrimary" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPrecioDiesel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Precio por galón (COP)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeColor="?attr/colorPrimary"
                            android:layout_marginTop="10dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPrecioDiesel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvRefDiesel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:drawablePadding="6dp"
                            android:background="@drawable/bg_price_badge"
                            tools:text="Precio CREG: $11.576/gal" />


                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón crear -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearEstacion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Crear estación"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="14dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>